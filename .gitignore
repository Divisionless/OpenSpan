# ============================================================
# OpenSpan .gitignore — pre-publication local snapshot.
# Keeps secrets and large binaries OUT of version control so this
# tree can be published later without leaking anything.
# ============================================================

# --- SECRETS: never commit (private SSH keys) ---
id_openspan
id_openspan.pub
id_laptop
id_laptop.pub
*.pem
*.key

# --- Large binaries / the VM itself ---
*.raw
debian-*.raw
vm/

# --- Transient logs & runtime scratch output ---
*.log
win/app-err.txt
win/app-out.txt
win/err.txt
win/out.txt
win/sender-err.txt
buildlog.txt
traytest.txt

# --- Python / editor junk ---
__pycache__/
*.pyc
*.pyo

# local settings hold the clipboard relay token -- never publish it
openspan_settings.json

# runtime state written by the balance slider
audio_balance.txt

# PyInstaller build artifacts (the ~70MB exe is built on demand, not tracked)
#
# These are PATTERNS, not filenames, and that distinction cost 149 MiB. The
# rule used to name the single file "OpenSpan.exe" -- but build_exe.py writes
# "OpenSpan.exe.prev" beside it as the rollback, and that name matched nothing.
# So the backup binary was tracked, and eight copies of a 68.8 MiB executable
# are in this repo's history. Ignore the CLASS of file; a build renamed
# tomorrow must not be able to re-open the same hole.
build/
dist/
*.exe
*.exe.prev
*.spec

# runtime state written by the app gain control
audio_gain.txt
# what the optional modules have OBSERVED on this machine -- the agent
# monitor's record of resets it actually watched happen. Per-machine, and
# a picture of when the user was working.
module_settings.json
# editor backup of the plan; plan.json itself is canonical and IS tracked
docs/plan/plan.json.bak

# personal / machine-specific runtime state (never publish)
bt_prefs.json
openspan_config.json
# named arrangements are pictures of the user's actual desk
profiles/
mode.txt
# Windows shortcuts embed the creating machine's name/IDs — never publish
*.lnk

# internal working notes (not part of the public project)
HANDOFF-PROMPT.md
CODE_REVIEW_2026-07-10.md
mouse-lag-research-prompt.md
preview-*.png
docs/maintenance-*/
.worktrees/
status.json
status.json.new

# --- LAN node identity (v3.121) ---
# node.json is THIS machine's private key. It is the node's identity, and two
# machines holding the same key are one node as far as every peer is concerned
# -- so it is never committed, and make-portable.ps1 never ships it either:
# a portable copy must be a FRESH node, not a clone.
node.json
# peers.json holds the shared secret of every pairing this machine has made.
# Committing it would hand anyone with the repo the ability to sign messages
# as this node to every machine it is paired with.
peers.json
node.json.new
peers.json.new
