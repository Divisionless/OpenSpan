[Unit]
Description=OpenSpan Bluetooth pairing agent (persistent, NoInputNoOutput auto-accept)
After=bluetooth.service
Requires=bluetooth.service

[Service]
# A single long-lived agent that stays registered so pairing always has an
# agent present to complete the just-works handshake. This is the piece that
# was missing -- ephemeral 'bluetoothctl agent on' calls unregister on exit.
ExecStart=/usr/bin/bt-agent -c NoInputNoOutput
Restart=always
RestartSec=3
# bt-agent ignores SIGTERM, and Requires=bluetooth.service means every
# bluetooth restart (btready does one at boot when radios arrive late) must
# stop this unit first. With the default 90s stop timeout that hang stalls
# systemd's whole job queue -- observed twice: lane restarts queued behind it
# until the app's ssh timeout. The agent is a stateless auto-accept helper;
# killing it outright loses nothing and Restart=always re-registers it.
KillSignal=SIGKILL
TimeoutStopSec=5

[Install]
WantedBy=multi-user.target
