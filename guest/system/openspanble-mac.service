[Unit]
Description=OpenSpan BLE HID peripheral daemon (managed Mac)
After=bluetooth.service openspan-btready.service
Requires=bluetooth.service
ConditionPathExists=/etc/systemd/system/openspanble-mac.service.d/20-radio.conf

[Service]
Type=simple
Environment=PYTHONUNBUFFERED=1
Environment=OPENSPAN_PORT=9956
Environment="OPENSPAN_DEVICE_NAME=OpenSpan Mac Control"
ExecStartPre=/opt/openspan/wait-hci0.sh
ExecStartPre=/opt/openspan/ensure-dualmode.sh
ExecStart=/usr/bin/python3 /opt/openspan/openspan_ble.py
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
